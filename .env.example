# Maison Rue Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# JWT Secret for HttpOnly Cookie Session
JWT_SECRET=your_jwt_secret_key_here

# Microsoft SQL Server Database Configuration
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=MaisonRueDB
DB_USER=sa
DB_PASSWORD=your_sql_password_here
DB_TRUST_SERVER_CERTIFICATE=true

# Rue Chatbot OpenAI Key (Optional)
VITE_CHAT_API_KEY=your_openai_api_key_here
