# Maison Rue Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Geoapify address autocomplete and address verification
# Get your API key from https://www.geoapify.com/ and set this key in your local .env (Server-side only).
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# JWT Secret for HttpOnly Cookie Session
JWT_SECRET=your_jwt_secret_key_here

# Microsoft SQL Server Database Configuration
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=MaisonRueDB
DB_USER=sa
# Mật khẩu SA: Nếu chạy MSSQL qua Docker (docker compose up -d mssql) thì giữ nguyên MaisonRue@2026!
# Nếu dùng SQL Server cài trực tiếp trên máy, hãy điền mật khẩu máy của bạn.
DB_PASSWORD=MaisonRue@2026!
DB_TRUST_SERVER_CERTIFICATE=true

# OpenAI API Key (Server-side only for Rue fashion advisory and address evidence analysis)
# Do NOT prefix with VITE_* to ensure key is kept strictly on server and never leaked to client bundle
OPENAI_API_KEY=your_openai_api_key_here

# Resend Transactional Email (Backend Only - NEVER prefix with VITE_)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL="MAISON RUE <notifications@mail.example.com>"
ALERT_EMAILS=your_operations_email@example.com
