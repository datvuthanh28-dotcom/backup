# Maison Rue Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Geoapify address autocomplete and address verification
# Get your API key from https://www.geoapify.com/ and set this key in your local .env (Server-side only).
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# JWT Secret for HttpOnly Cookie Session
JWT_SECRET=your_jwt_secret_key_here

# Microsoft SQL Server Database Configuration
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=MaisonRueDB
DB_USER=sa
DB_PASSWORD=your_local_sql_server_password
DB_TRUST_SERVER_CERTIFICATE=true

# OpenAI API Key (Server-side only for Rue fashion advisory and address evidence analysis)
# Do NOT prefix with VITE_* to ensure key is kept strictly on server and never leaked to client bundle
OPENAI_API_KEY=your_openai_api_key_here

# EmailJS Configuration
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
VITE_EMAILJS_ORDER_TEMPLATE_ID=your_order_template_id
VITE_EMAILJS_STOCK_TEMPLATE_ID=your_stock_template_id
VITE_EMAILJS_RETURN_TEMPLATE_ID=your_return_template_id
VITE_ALERT_EMAILS=your_operations_email@example.com
